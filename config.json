{
  "server": "localhost:8080",
  "download_dir": "downloads",
  "tls": {
    "enabled": false,
    "insecure_skip_verify": false
  },
  "timeouts": {
    "connect": "10s",
    "io": "2h"
  },
  "network": {
    "lan_direct": true,
    "internet_p2p": true,
    "stun_servers": [
      "stun.l.google.com:19302"
    ],
    "p2p_discovery_timeout": "1500ms",
    "p2p_connect_timeout": "5s",
    "parallel_streams": 4
  }
}
